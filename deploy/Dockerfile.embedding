# syntax=docker/dockerfile:1
# 检索服务镜像：离线 BGE 向量模型（ONNX Runtime，CPU）常驻加载，后端通过 -embedding-endpoint 调用。
# PyTorch 只在 export 阶段把固定版本权重导出为 model.onnx 并校验向量一致，不进入运行镜像。
FROM python:3.12-slim-trixie AS export
COPY deploy/pip-requirements.txt /setup/deploy/pip-requirements.txt
RUN python -m venv /opt/export \
    && /opt/export/bin/pip install --no-cache-dir --require-hashes -r /setup/deploy/pip-requirements.txt
COPY deploy/embedding-export-requirements.txt /setup/deploy/embedding-export-requirements.txt
RUN /opt/export/bin/pip install --no-cache-dir --require-hashes \
       -r /setup/deploy/embedding-export-requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu
COPY scripts/setup-local-embedding.py /setup/scripts/setup-local-embedding.py
COPY deploy/licenses/bge-small-zh-v1.5-LICENSE /setup/deploy/licenses/bge-small-zh-v1.5-LICENSE
RUN python /setup/scripts/setup-local-embedding.py
COPY internal/adapter/localembedding/embed.py /setup/internal/adapter/localembedding/embed.py
COPY scripts/export-embedding-onnx.py /setup/scripts/export-embedding-onnx.py
RUN /opt/export/bin/python /setup/scripts/export-embedding-onnx.py /setup/.data/evidence-embedding/model \
    && mkdir /out \
    && cd /setup/.data/evidence-embedding/model \
    && cp model.onnx config.json tokenizer.json manifest.json LICENSE README.md /out/

FROM python:3.12-slim-trixie AS runtime
COPY deploy/pip-requirements.txt /setup/deploy/pip-requirements.txt
RUN python -m venv /opt/evidence-embedding/runtime \
    && /opt/evidence-embedding/runtime/bin/pip install --no-cache-dir --require-hashes \
       -r /setup/deploy/pip-requirements.txt
COPY deploy/embedding-requirements.txt /setup/deploy/embedding-requirements.txt
RUN /opt/evidence-embedding/runtime/bin/pip install --no-cache-dir --require-hashes \
       -r /setup/deploy/embedding-requirements.txt \
    && /opt/evidence-embedding/runtime/bin/python -m pip uninstall -y pip

FROM python:3.12-slim-trixie
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends libstdc++6 \
    && python -m pip uninstall -y pip \
    && rm -rf /var/lib/apt/lists/* /usr/local/lib/python3.12/ensurepip
COPY --from=runtime /opt/evidence-embedding/runtime/ /opt/evidence-embedding/runtime/
COPY --from=export /out/ /opt/evidence-embedding/model/
# 与后端本机模式共用同一份推理代码，向量和索引身份在两种模式下一致。
COPY internal/adapter/localembedding/embed.py deploy/embedding/server.py /opt/evidence-embedding/service/
COPY deploy/licenses/bge-small-zh-v1.5-LICENSE /usr/share/licenses/drama-agent/third-party/
COPY LICENSE NOTICE /usr/share/licenses/drama-agent/
ENV TOKENIZERS_PARALLELISM=false HOME=/tmp
USER 65534:65534
EXPOSE 8791
CMD ["/opt/evidence-embedding/runtime/bin/python", "/opt/evidence-embedding/service/server.py", \
     "--listen", "0.0.0.0:8791", "--model", "/opt/evidence-embedding/model"]
