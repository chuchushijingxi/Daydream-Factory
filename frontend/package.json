    "@radix-ui/react-slot": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "23.16.8",
    "lucide-react": "0.561.0",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "14.1.3",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
