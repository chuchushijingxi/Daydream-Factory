{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drama-agent:storyboard-contract:v1",
  "$ref": "#/$defs/ChangeInput",
  "$defs": {
    "SourcePoint": {"type":"object","properties":{"spanId":{"type":"string","minLength":1},"offset":{"type":"integer","minimum":0}},"required":["spanId","offset"],"additionalProperties":false},
    "SourceRange": {"type":"object","properties":{"start":{"$ref":"#/$defs/SourcePoint"},"end":{"$ref":"#/$defs/SourcePoint"}},"required":["start","end"],"additionalProperties":false},
    "SourceRanges": {"type":"array","items":{"$ref":"#/$defs/SourceRange"},"minItems":1},
    "AssetRef": {"type":"object","properties":{"assetId":{"type":"string","minLength":1},"lookId":{"type":"string","minLength":1}},"required":["assetId"],"additionalProperties":false},
    "SelectedAssets": {"description":"当前镜头实际主体/说话人、地点及剧情道具的精确资产/角色形象引用；从完整项目目录理解选择，不以名称为身份。","type":"array","items":{"$ref":"#/$defs/AssetRef"},"minItems":0,"uniqueItems":true},
    "TextPart": {"type":"object","properties":{"type":{"const":"text"},"text":{"type":"string","minLength":1}},"required":["type","text"],"additionalProperties":false},
    "AssetPart": {"description":"正文当前位置的真实 AssetRef，必须精确存在于本镜头 selectedAssets；显示名称及厂商图片编号不是输入字段。","type":"object","properties":{"type":{"const":"asset"},"assetId":{"type":"string","minLength":1},"lookId":{"type":"string","minLength":1}},"required":["type","assetId"],"additionalProperties":false},
    "PromptPart": {"oneOf":[{"$ref":"#/$defs/TextPart"},{"$ref":"#/$defs/AssetPart"}]},
    "VideoPrompt": {"description":"本连续镜头唯一可编辑正文：主体/空间和初态、动作与完整对白推进、摄影及结束画面/承接；文字和资产节点按实际出现顺序保存，不要求固定三秒切段。","type":"object","properties":{"parts":{"type":"array","items":{"$ref":"#/$defs/PromptPart"},"minItems":1}},"required":["parts"],"additionalProperties":false},
    "Dialogue": {"description":"完整保留本镜头承载的对白/旁白及真实说话人归属，不只摘关键句；画外说话不等于画面出场。","type":"object","properties":{"speakerAssetId":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"text":{"type":"string","minLength":1}},"required":["speakerAssetId","text"],"additionalProperties":false},
    "Camera": {"type":"object","properties":{"size":{"type":"string"},"angle":{"type":"string"},"movement":{"type":"string"}},"required":["size","angle","movement"],"additionalProperties":false},
    "EpisodeValue": {"description":"从完整原文自动识别的分集及来源；episodeNumber是原数字集号，无数字如上集/下集为null，原题照存。集号不是身份/集数，整篇由segmentation=whole区分，不伪造第1集。","type":"object","properties":{"episodeNumber":{"anyOf":[{"type":"integer"},{"type":"null"}]},"title":{"type":"string","minLength":1},"sourceRanges":{"$ref":"#/$defs/SourceRanges"}},"required":["episodeNumber","title","sourceRanges"],"additionalProperties":false},
    "EpisodePatch": {"type":"object","properties":{"episodeNumber":{"anyOf":[{"type":"integer"},{"type":"null"}]},"title":{"type":"string","minLength":1},"sourceRanges":{"$ref":"#/$defs/SourceRanges"}},"required":[],"additionalProperties":false,"minProperties":1},
    "SceneValue": {"type":"object","properties":{"title":{"type":"string","minLength":1},"sourceRanges":{"$ref":"#/$defs/SourceRanges"},"locationAssetId":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"time":{"type":"string"},"summary":{"type":"string"}},"required":["title","sourceRanges","locationAssetId","time","summary"],"additionalProperties":false},
    "ScenePatch": {"type":"object","properties":{"title":{"type":"string","minLength":1},"sourceRanges":{"$ref":"#/$defs/SourceRanges"},"locationAssetId":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"time":{"type":"string"},"summary":{"type":"string"}},"required":[],"additionalProperties":false,"minProperties":1},
    "ShotValue": {"description":"所属场景内一个连续镜头，保留原文动作及完整对白，摄影设计与原文事实区分；切镜应为相邻 Shot。","type":"object","properties":{"sourceRanges":{"$ref":"#/$defs/SourceRanges"},"action":{"type":"string","description":"主体初态、动作按序推进及结果，不增加原文没有的事件。"},"dialogues":{"type":"array","items":{"$ref":"#/$defs/Dialogue"},"minItems":0},"camera":{"$ref":"#/$defs/Camera"},"durationSeconds":{"anyOf":[{"type":"number","exclusiveMinimum":0},{"type":"null"}]},"designNotes":{"type":"string","description":"必要表演、光线、结束画面与前后镜承接的补充拍摄设计，无依据内容不强填。"},"selectedAssets":{"$ref":"#/$defs/SelectedAssets"},"videoPrompt":{"anyOf":[{"$ref":"#/$defs/VideoPrompt"},{"type":"null"}]}},"required":["sourceRanges","action","dialogues","camera","durationSeconds","designNotes","selectedAssets","videoPrompt"],"additionalProperties":false},
    "ShotPatch": {"type":"object","properties":{"sourceRanges":{"$ref":"#/$defs/SourceRanges"},"action":{"type":"string"},"dialogues":{"type":"array","items":{"$ref":"#/$defs/Dialogue"},"minItems":0},"camera":{"$ref":"#/$defs/Camera"},"durationSeconds":{"anyOf":[{"type":"number","exclusiveMinimum":0},{"type":"null"}]},"designNotes":{"type":"string"},"selectedAssets":{"$ref":"#/$defs/SelectedAssets"},"videoPrompt":{"anyOf":[{"$ref":"#/$defs/VideoPrompt"},{"type":"null"}]},"sceneId":{"type":"string","minLength":1}},"required":[],"additionalProperties":false,"minProperties":1},
    "createEpisode": {"type":"object","properties":{"op":{"const":"createEpisode"},"value":{"$ref":"#/$defs/EpisodeValue"}},"required":["op","value"],"additionalProperties":false},
    "updateEpisode": {"type":"object","properties":{"op":{"const":"updateEpisode"},"episodeId":{"type":"string","minLength":1},"patch":{"$ref":"#/$defs/EpisodePatch"}},"required":["op","episodeId","patch"],"additionalProperties":false},
    "deleteEpisode": {"type":"object","properties":{"op":{"const":"deleteEpisode"},"episodeId":{"type":"string","minLength":1}},"required":["op","episodeId"],"additionalProperties":false},
    "setSupportRanges": {"type":"object","properties":{"op":{"const":"setSupportRanges"},"ranges":{"type":"array","items":{"$ref":"#/$defs/SourceRange"},"minItems":0}},"required":["op","ranges"],"additionalProperties":false},
    "setSegmentation": {"type":"object","properties":{"op":{"const":"setSegmentation"},"segmentation":{"type":"string","enum":["episodes","whole"]}},"required":["op","segmentation"],"additionalProperties":false},
    "createScene": {"type":"object","properties":{"op":{"const":"createScene"},"episodeId":{"type":"string","minLength":1},"value":{"$ref":"#/$defs/SceneValue"}},"required":["op","episodeId","value"],"additionalProperties":false},
    "updateScene": {"type":"object","properties":{"op":{"const":"updateScene"},"sceneId":{"type":"string","minLength":1},"patch":{"$ref":"#/$defs/ScenePatch"}},"required":["op","sceneId","patch"],"additionalProperties":false},
    "deleteScene": {"type":"object","properties":{"op":{"const":"deleteScene"},"sceneId":{"type":"string","minLength":1}},"required":["op","sceneId"],"additionalProperties":false},
    "setSceneOrder": {"type":"object","properties":{"op":{"const":"setSceneOrder"},"episodeId":{"type":"string","minLength":1},"sceneIds":{"type":"array","items":{"type":"string","minLength":1},"minItems":0,"uniqueItems":true}},"required":["op","episodeId","sceneIds"],"additionalProperties":false},
    "createShot": {"type":"object","properties":{"op":{"const":"createShot"},"sceneId":{"type":"string","minLength":1},"beforeShotId":{"type":"string","minLength":1},"afterShotId":{"type":"string","minLength":1},"value":{"$ref":"#/$defs/ShotValue"}},"required":["op","sceneId","value"],"additionalProperties":false},
    "updateShot": {"type":"object","properties":{"op":{"const":"updateShot"},"shotId":{"type":"string","minLength":1},"patch":{"$ref":"#/$defs/ShotPatch"}},"required":["op","shotId","patch"],"additionalProperties":false},
    "deleteShot": {"type":"object","properties":{"op":{"const":"deleteShot"},"shotId":{"type":"string","minLength":1}},"required":["op","shotId"],"additionalProperties":false},
    "setShotOrder": {"type":"object","properties":{"op":{"const":"setShotOrder"},"sceneId":{"type":"string","minLength":1},"shotIds":{"type":"array","items":{"type":"string","minLength":1},"minItems":0,"uniqueItems":true}},"required":["op","sceneId","shotIds"],"additionalProperties":false},
    "IndexOperation": {"oneOf":[{"$ref":"#/$defs/createEpisode"},{"$ref":"#/$defs/updateEpisode"},{"$ref":"#/$defs/deleteEpisode"},{"$ref":"#/$defs/setSupportRanges"},{"$ref":"#/$defs/setSegmentation"}]},
    "StoryboardOperation": {"oneOf":[{"$ref":"#/$defs/createScene"},{"$ref":"#/$defs/updateScene"},{"$ref":"#/$defs/deleteScene"},{"$ref":"#/$defs/setSceneOrder"},{"$ref":"#/$defs/createShot"},{"$ref":"#/$defs/updateShot"},{"$ref":"#/$defs/deleteShot"},{"$ref":"#/$defs/setShotOrder"}]},
    "Operation": {"oneOf":[{"$ref":"#/$defs/IndexOperation"},{"$ref":"#/$defs/StoryboardOperation"}]},
    "Empty": {"type":"object","properties":{},"required":[],"additionalProperties":false},
    "ReadAssets": {"type":"object","properties":{"targets":{"type":"array","items":{"$ref":"#/$defs/AssetRef"},"minItems":1,"uniqueItems":true}},"required":["targets"],"additionalProperties":false},
    "SaveEpisodeRanges": {"type":"object","properties":{"operations":{"type":"array","items":{"$ref":"#/$defs/IndexOperation"},"minItems":1}},"required":["operations"],"additionalProperties":false},
    "SaveStoryboard": {"type":"object","properties":{"operations":{"type":"array","items":{"$ref":"#/$defs/StoryboardOperation"},"minItems":1}},"required":["operations"],"additionalProperties":false},
    "PromptPatch": {"type":"object","properties":{"videoPrompt":{"$ref":"#/$defs/VideoPrompt"}},"required":["videoPrompt"],"additionalProperties":false},
    "PromptOperation": {"type":"object","properties":{"op":{"const":"updateShot"},"shotId":{"type":"string","minLength":1},"patch":{"$ref":"#/$defs/PromptPatch"}},"required":["op","shotId","patch"],"additionalProperties":false},
    "SavePrompts": {"type":"object","properties":{"operations":{"type":"array","items":{"$ref":"#/$defs/PromptOperation"},"minItems":1}},"required":["operations"],"additionalProperties":false},
    "RevisionInput": {"type":"object","properties":{"revision":{"type":"integer","minimum":1}},"required":["revision"],"additionalProperties":false},
    "EpisodeRunInput": {"oneOf":[{"type":"object","properties":{"revision":{"type":"integer","minimum":1},"operation":{"const":"breakdown"},"breakdownMode":{"type":"string","enum":["general","story","production"]}},"required":["revision","operation"],"additionalProperties":false},{"type":"object","properties":{"revision":{"type":"integer","minimum":1},"operation":{"const":"fillPrompts"}},"required":["revision","operation"],"additionalProperties":false},{"type":"object","properties":{"revision":{"type":"integer","minimum":1},"operation":{"const":"regeneratePrompts"},"shotIds":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true}},"required":["revision","operation","shotIds"],"additionalProperties":false}]},
    "ChangeInput": {"type":"object","properties":{"revision":{"type":"integer","minimum":1},"operations":{"type":"array","items":{"$ref":"#/$defs/Operation"},"minItems":1}},"required":["revision","operations"],"additionalProperties":false},
    "SearchScriptEvidence": {"type":"object","properties":{"query":{"type":"string","minLength":1,"maxLength":1024},"limit":{"type":"integer","minimum":1,"maximum":20},"offset":{"type":"integer","minimum":0,"maximum":16362}},"required":["query"],"additionalProperties":false},
    "ReadScriptEvidence": {"type":"object","properties":{"spanIds":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":32},"before":{"type":"integer","minimum":0,"maximum":8},"after":{"type":"integer","minimum":0,"maximum":8}},"required":["spanIds"],"additionalProperties":false}
  }
}